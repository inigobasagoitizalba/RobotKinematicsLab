<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          Automatic transfer is disabled to prevent partial research workspaces. A portable,
          integrity-checked export flow is still required before production.
        -->
        <exclude domain="file" path="RobotKinematicsLab" />
        <exclude domain="external" path="Documents/RobotKinematicsLab" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="RobotKinematicsLab" />
        <exclude domain="external" path="Documents/RobotKinematicsLab" />
    </device-transfer>
</data-extraction-rules>
